#usda 1.0
(
    customLayerData = {
        dictionary rig = {
            double camera_above_lidar_m = 0.15
            double environment_z_offset_m = 0.7695705931503188
            double lens_baseline_m = 0.03
            double lens_fov_deg = 200
            int lens_resolution_px = 1920
            double lidar_height_m = 0.55
            bool lidar_inverted = 0
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment" (
        prepend references = @../assets/isaac/Isaac/Environments/Simple_Room/simple_room.usd@
    )
    {
        double3 xformOp:translate = (0, 0, 0.7695705931503188)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsScene "PhysicsScene"
    {
    }

    def Xform "Rig"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (-2, -1.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "MID360" (
            prepend references = @../third_party/Livox_MID360_IsaacSim/assets/petal_scan/standalone/Livox_MID360_Petal_Scan.usd@
        )
        {
            double3 xformOp:translate = (-0, -0, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            over "torso_link"
            {
                over "mid360_link"
                {
                    over "CAD"
                    {
                        float xformOp:rotateX = 90
                        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:rotateX"]
                    }
                }
            }
        }

        def Xform "Insta360"
        {
            double3 xformOp:translate = (0, 0, 0.7000000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Camera "lens_front" (
                prepend apiSchemas = ["OmniLensDistortionFthetaAPI"]
            )
            {
                float2 clippingRange = (0.01, 1000)
                float omni:lensdistortion:ftheta:k0 = 0
                float omni:lensdistortion:ftheta:k1 = 0.0018180513
                float omni:lensdistortion:ftheta:k2 = 0
                float omni:lensdistortion:ftheta:k3 = 0
                float omni:lensdistortion:ftheta:k4 = 0
                float omni:lensdistortion:ftheta:maxFov = 200
                float omni:lensdistortion:ftheta:nominalHeight = 1920
                float omni:lensdistortion:ftheta:nominalWidth = 1920
                float2 omni:lensdistortion:ftheta:opticalCenter = (960, 960)
                token omni:lensdistortion:model = "ftheta"
                quatd xformOp:orient = (-0.5000000000000002, -0.5, 0.5, 0.5)
                double3 xformOp:translate = (0.015, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Camera "lens_back" (
                prepend apiSchemas = ["OmniLensDistortionFthetaAPI"]
            )
            {
                float2 clippingRange = (0.01, 1000)
                float omni:lensdistortion:ftheta:k0 = 0
                float omni:lensdistortion:ftheta:k1 = 0.0018180513
                float omni:lensdistortion:ftheta:k2 = 0
                float omni:lensdistortion:ftheta:k3 = 0
                float omni:lensdistortion:ftheta:k4 = 0
                float omni:lensdistortion:ftheta:maxFov = 200
                float omni:lensdistortion:ftheta:nominalHeight = 1920
                float omni:lensdistortion:ftheta:nominalWidth = 1920
                float2 omni:lensdistortion:ftheta:opticalCenter = (960, 960)
                token omni:lensdistortion:model = "ftheta"
                quatd xformOp:orient = (0.4999999999999999, 0.5000000000000001, 0.5000000000000001, 0.5000000000000001)
                double3 xformOp:translate = (-0.015, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }
}

