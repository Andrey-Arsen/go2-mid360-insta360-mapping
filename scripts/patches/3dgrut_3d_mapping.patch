diff --git a/threedgrut/trainer.py b/threedgrut/trainer.py
index 4ce21e7..a11a09d 100644
--- a/threedgrut/trainer.py
+++ b/threedgrut/trainer.py
@@ -735,8 +735,42 @@ class Trainer3DGRUT:
                 loss_scale = torch.abs(self.model.get_scale()).mean()
                 lambda_scale = self.conf.loss.lambda_scale
 
+        # Anti-needle regularization (3d_mapping patch): penalize Gaussians whose longest axis is much
+        # longer than the middle one (needles; flat discs on surfaces are fine) and oversized ones.
+        loss_aniso = torch.zeros(1, device=self.device)
+        lambda_aniso = 0.0
+        if self.conf.loss.get("use_aniso", False) and not self._in_color_refine:
+            with torch.cuda.nvtx.range("loss-aniso"):
+                s_sorted = torch.sort(self.model.get_scale(), dim=1).values
+                ratio = s_sorted[:, 2] / (s_sorted[:, 1] + 1e-8)
+                loss_aniso = torch.relu(ratio - self.conf.loss.aniso_max_ratio).mean()
+                lambda_aniso = self.conf.loss.lambda_aniso
+        loss_max_scale = torch.zeros(1, device=self.device)
+        lambda_max_scale = 0.0
+        if self.conf.loss.get("use_max_scale", False) and not self._in_color_refine:
+            with torch.cuda.nvtx.range("loss-max-scale"):
+                s_max = self.model.get_scale().max(dim=1).values
+                loss_max_scale = torch.relu(s_max - self.conf.loss.max_scale).mean()
+                lambda_max_scale = self.conf.loss.lambda_max_scale
+
+        # Depth prior (3d_mapping patch): relative L1 between rendered ray distance and a known depth
+        # (e.g. rendered from the lidar mesh) where it is known and the pixel is not masked out.
+        loss_depth = torch.zeros(1, device=self.device)
+        lambda_depth = 0.0
+        if self.conf.loss.get("use_depth", False) and getattr(gpu_batch, "depth", None) is not None:
+            with torch.cuda.nvtx.range("loss-depth"):
+                d_gt = gpu_batch.depth / torch.linalg.norm(gpu_batch.rays_dir, dim=-1, keepdim=True).clamp(min=1e-8)
+                valid = gpu_batch.depth > 0
+                if mask is not None:
+                    valid = valid & (mask > 0.5)
+                if valid.any():
+                    err = torch.abs(outputs["pred_dist"] - d_gt) / d_gt.clamp(min=0.1)
+                    loss_depth = err[valid].mean()
+                    lambda_depth = self.conf.loss.lambda_depth
+
         # Total loss
         loss = lambda_l1 * loss_l1 + lambda_ssim * loss_ssim + lambda_opacity * loss_opacity + lambda_scale * loss_scale
+        loss = loss + lambda_aniso * loss_aniso + lambda_max_scale * loss_max_scale + lambda_depth * loss_depth
         return dict(
             total_loss=loss,
             l1_loss=lambda_l1 * loss_l1,
@@ -744,6 +778,9 @@ class Trainer3DGRUT:
             ssim_loss=lambda_ssim * loss_ssim,
             opacity_loss=lambda_opacity * loss_opacity,
             scale_loss=lambda_scale * loss_scale,
+            aniso_loss=lambda_aniso * loss_aniso,
+            max_scale_loss=lambda_max_scale * loss_max_scale,
+            depth_loss=lambda_depth * loss_depth,
         )
 
     @torch.cuda.nvtx.range("log_validation_iter")
