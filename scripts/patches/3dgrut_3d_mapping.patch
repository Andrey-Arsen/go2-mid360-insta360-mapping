@@ -184,6 +184,20 @@ loss:
   use_scale: false
   lambda_scale: 0.0
 
+  # 3d_mapping patch: anti-needle regularization (longest/middle axis ratio above aniso_max_ratio)
+  use_aniso: false
+  lambda_aniso: 0.0
+  aniso_max_ratio: 10.0
+
+  # 3d_mapping patch: penalize Gaussians larger than max_scale (scene units; ours are meters)
+  use_max_scale: false
+  lambda_max_scale: 0.0
+  max_scale: 0.5
+
+  # 3d_mapping patch: depth prior from <image>_depth.png (uint16 mm, 0 = unknown), relative L1
+  use_depth: false
+  lambda_depth: 0.0
+
 # Post-processing configuration
 post_processing:
   # null | "ppisp" | "linear-to-srgb"
